{
  "title": "B2B Monolith - Memory Analysis",
  "uid": "b2b-monolith-memory",
  "schemaVersion": 38,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"monolith\", area=\"heap\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_committed_bytes{job=\"monolith\", area=\"heap\"}",
          "legendFormat": "Heap Committed"
        },
        {
          "expr": "jvm_memory_max_bytes{job=\"monolith\", area=\"heap\"}",
          "legendFormat": "Heap Max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 2,
      "title": "JVM Non-Heap Memory",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"monolith\", area=\"nonheap\"}",
          "legendFormat": "Non-Heap Used"
        },
        {
          "expr": "jvm_memory_committed_bytes{job=\"monolith\", area=\"nonheap\"}",
          "legendFormat": "Non-Heap Committed"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 3,
      "title": "Metaspace",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"monolith\", id=\"Metaspace\"}",
          "legendFormat": "Metaspace Used"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 4,
      "title": "Code Cache",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"monolith\", id=\"CodeCache\"}",
          "legendFormat": "Code Cache Used"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "title": "Container RSS Memory (cAdvisor)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "container_memory_rss{name=\"monolith-app\"}",
          "legendFormat": "Container RSS"
        },
        {
          "expr": "container_memory_usage_bytes{name=\"monolith-app\"}",
          "legendFormat": "Container Total"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6,
      "title": "GC Pause Duration",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=\"monolith\"}[1m])",
          "legendFormat": "GC Pause Rate ({{action}})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "title": "GC Collections Count",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{job=\"monolith\"}[1m])",
          "legendFormat": "GC Count Rate ({{action}})"
        }
      ]
    }
  ]
}
